cc_option_to_cc[MKDS_OPTIONS_CLASS_ROW_OPTIONS] NCP_USED = {
    MKDS_CC_MODE_50, MKDS_CC_MODE_100, MKDS_CC_MODE_150,
    MKDS_CC_MODE_200, MKDS_CC_MODE_250, MKDS_CC_MODE_300,
    MKDS_CC_MODE_150,
};

static const uint32_t cc_cc_to_option[6] NCP_USED = {
    MKDS_CLASS_50, MKDS_CLASS_100, MKDS_CLASS_150,
    MKDS_CLASS_200, MKDS_CLASS_250, MKDS_CLASS_300,
};

static const uint32_t cc_unlock_category[6] NCP_USED = {
    MKDS_UNLOCK_50, MKDS_UNLOCK_100, MKDS_UNLOCK_150,
    MKDS_UNLOCK_150, MKDS_UNLOCK_150, MKDS_UNLOCK_150,
};

NCP_OVER(CLASS_ROW_COUNT) uint16_t cc_class_row_count NCP_USED =
