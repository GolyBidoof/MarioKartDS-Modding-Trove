cc_class_message_ids[MKDS_OPTIONS_CLASS_ROW_OPTIONS] NCP_USED = {
    MKDS_MSG_50CC, MKDS_MSG_100CC, MKDS_MSG_150CC,
    MSG_200CC, MSG_250CC, MSG_300CC,
    MKDS_MSG_MIRROR,
};

